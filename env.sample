# Copy this file to `.env.local` (development) or set these in Vercel (production).

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/madina-mobile-gadgets

# --- Auth (REQUIRED in production) ---
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Public site URL (used for SEO, sitemap, password-reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudinary (server-side only, never exposed to the browser) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=madina-mobile-gadgets

# --- Email (optional; used for password reset). If unset, reset links are logged to the server console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Madina Mobile Gadgets <no-reply@example.com>"

# --- Seed: initial admin account (used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@madinamobile.pk
SEED_ADMIN_PASSWORD=ChangeMe!2026
